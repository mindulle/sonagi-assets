{
    "version": "1.0.0",
    "description": "렌더 산출물 L1 기계 판정 룰셋. 결정론적이며 LLM을 쓰지 않는다. 값을 바꾸면 반드시 version을 올리고 python3 scripts/judgment_golden.py --update 로 판정 기준선을 갱신한다.",
    "rules": [
        {
            "id": "canvas.size",
            "severity": "fail",
            "min_width": 200,
            "min_height": 200,
            "description": "캔버스가 100×100 같은 기본값에 찌그러지지 않았는가"
        },
        {
            "id": "canvas.squash",
            "severity": "fail",
            "min_block_height": 8,
            "description": "블록 높이가 0~8px로 눌리지 않았는가(내용이 안 들어간 컨테이너)"
        },
        {
            "id": "block.overlap",
            "severity": "fail",
            "tolerance": 1.0,
            "description": "인접 블록이 겹치지 않았는가(±1px 반올림 허용)"
        },
        {
            "id": "layer.required",
            "severity": "fail",
            "required": ["hero"],
            "min_layers": 6,
            "description": "Figma에서 레이어로 풀릴 <g id> 그룹이 살아있는가"
        },
        {
            "id": "text.contrast",
            "severity": "warn",
            "floor": 3.0,
            "body": 4.5,
            "large": 3.0,
            "large_px": 24,
            "description": "텍스트 대비. floor 미만은 읽을 수 없어 FAIL, AA 미달은 WARN"
        },
        {
            "id": "text.overflow",
            "severity": "warn",
            "margin": 2,
            "description": "텍스트가 캔버스 오른쪽 경계를 넘는가(글자폭 근사)"
        },
        {
            "id": "license.scope",
            "severity": "fail",
            "description": "blocked 자산이 들어갔거나 license_ok가 false인가"
        },
        {
            "id": "contract.present",
            "severity": "fail",
            "description": "매니페스트에 계약 헤더 4칸이 있는가"
        },
        {
            "id": "contract.stale",
            "severity": "warn",
            "description": "산출물의 ruleset_version이 현재 룰셋과 다른가(재판정 필요)"
        }
    ]
}
